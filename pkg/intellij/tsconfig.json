{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": []
  },
  "include": ["webview/**/*.ts", "webview/**/*.tsx", "../vscode/src/webview/**/*.ts", "../vscode/src/webview/**/*.tsx", "../vscode/src/chat/state.ts", "../vscode/src/acp/types.ts"]
}
